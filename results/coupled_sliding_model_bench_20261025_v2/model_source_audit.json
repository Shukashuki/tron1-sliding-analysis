  "findings": [
    {
      "model": "Chrono Fiala",
      "finding": "Coupled longitudinal/lateral effects; documented zero-camber assumption. Not a camber-steering model."
    },
    {
      "model": "Chrono basic TMeasy",
      "finding": "Audited file has low-speed Dahl bristle state and combined force curve. gamma enters overturning Mx; no explicit gamma-to-Fy term in this file. Do not infer commercial-version capability."
    },
    {
      "model": "Chrono Pac02",
      "finding": "Has gamma-dependent tire forces. Current default camber clamp is3deg and is adjustable; the code says this avoids extrapolation beyond tire testing. Large-TRON1-camber use needs identified parameters and validation."
    },
    {
      "model": "PhysX Vehicle default tire",
      "finding": "Documented combined-force normalization and camber stiffness. Separate Vehicle force model, not automatically part of an articulated rigid cylinder; not full Pacejka."
    }
  ],
